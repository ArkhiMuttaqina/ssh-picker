#!/usr/bin/env bash
set -euo pipefail

VERSION="1.0.0"
config_file="${HOME}/.ssh/config"
mode="pick"
selected_host=""

die() {
  printf 'sshpick: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage: sshp [options]

Pick an SSH host from ~/.ssh/config with fzf, preview its resolved settings,
and connect with OpenSSH.

Options:
  -c, --config FILE   Use a different SSH config
  -l, --list          List selectable host aliases and exit
      --preview HOST  Print resolved non-secret settings for HOST
      --version       Print version and exit
  -h, --help          Show this help
EOF
}

list_hosts() {
  awk '
    BEGIN { IGNORECASE = 1 }
    /^[[:space:]]*Host[[:space:]]+/ {
      for (i = 2; i <= NF; i++) {
        if ($i !~ /[*?!]/ && $i !~ /^#/) print $i
      }
    }
  ' "$config_file" | LC_ALL=C sort -u
}

preview_host() {
  local host="$1"
  printf 'Host %s\n\n' "$host"
  ssh -F "$config_file" -G -- "$host" 2>/dev/null |
    awk '
      # ssh -G may emit inherited/repeated directives (notably identityfile).
      # The picker has one compact detail card, so keep the first effective
      # value for each supported field and never render a second row/card.
      {
        key = tolower($1)
        if (key == "hostname" || key == "user" || key == "port" ||
            key == "proxyjump" || key == "proxycommand" ||
            key == "identityfile" || key == "identitiesonly" ||
            key == "forwardagent" || key == "requesttty") {
          if (!seen[key]++) {
            value = $0
            sub(/^[^[:space:]]+[[:space:]]+/, "", value)
            printf "%-16s %s\n", key, value
          }
        }
      }
    '
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    -c|--config)
      [ "$#" -ge 2 ] || die "$1 needs a file"
      config_file="$2"
      shift 2
      ;;
    -l|--list)
      mode="list"
      shift
      ;;
    --preview)
      [ "$#" -ge 2 ] || die "$1 needs a host"
      mode="preview"
      selected_host="$2"
      shift 2
      ;;
    --version)
      printf 'sshpick %s\n' "$VERSION"
      exit 0
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    *)
      die "unknown option: $1"
      ;;
  esac
done

[ -f "$config_file" ] || die "SSH config not found: $config_file"

case "$mode" in
  list)
    list_hosts
    exit 0
    ;;
  preview)
    preview_host "$selected_host"
    exit 0
    ;;
esac

command -v ssh >/dev/null 2>&1 || die "ssh is required"
command -v fzf >/dev/null 2>&1 || die "fzf is required (Ubuntu/Debian: sudo apt-get install fzf)"

hosts="$(list_hosts)"
[ -n "$hosts" ] || die "no concrete Host aliases found in $config_file"

self="$(command -v sshp 2>/dev/null || command -v sshpick 2>/dev/null || printf '%s' "$0")"
printf -v preview_command '%q --config %q --preview {}' "$self" "$config_file"

selected_host="$(printf '%s\n' "$hosts" | fzf \
  --prompt='SSH › ' \
  --pointer='▸' \
  --marker='✓' \
  --height='60%' \
  --layout=reverse \
  --border=rounded \
  --color='fg:#d0d0d0,bg:#1a1b26,hl:#7aa2f7,fg+:#c0caf5,bg+:#292e42,hl+:#7aa2f7' \
  --color='pointer:#f7768e,marker:#9ece6a,prompt:#7dcfff,border:#565f89,info:#9d7cd8' \
  --preview "$preview_command" \
  --preview-window='right:50%:wrap' \
  --header='╼ SSH Host Picker ╾  │  enter: connect  │  esc: cancel')" || exit 0

[ -n "$selected_host" ] || exit 0
printf '\n→ Connecting to \033[1;36m%s\033[0m ...\n' "$selected_host"
exec ssh -F "$config_file" -- "$selected_host"
